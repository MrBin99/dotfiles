#!/usr/bin/env {{ .chezmoi.homeDir }}/.local/bin/fish

chezmoi completion fish > $HOME/.config/fish/completions/chezmoi.fish
mise completion fish > $HOME/.config/fish/completions/mise.fish
starship completions fish > $HOME/.config/fish/completions/starship.fish
rg --generate=complete-fish > $HOME/.config/fish/completions/rg.fish
bat --completion fish > $HOME/.config/fish/completions/bat.fish
fd --gen-completions fish > $HOME/.config/fish/completions/fd.fish
docker completion fish > $HOME/.config/fish/completions/docker.fish
mailpit completion fish > $HOME/.config/fish/completions/mailpit.fish
delta --generate-completion fish > $HOME/.config/fish/completions/delta.fish

fish_update_completions
